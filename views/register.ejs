<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Todo App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center vh-100">
  <div class="container" style="max-width: 400px;">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h3 class="card-title text-center mb-4">Daftar Akun</h3>
        <% if (error) { %>
          <div class="alert alert-danger p-2 small"><%= error %></div>
        <% } %>
        <form action="/register" method="POST">
          <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" required placeholder="Buat username">
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required placeholder="Buat password">
          </div>
          <button type="submit" class="btn btn-success w-100 fw-bold">Daftar</button>
        </form>
        <p class="text-center mt-3 mb-0 small text-muted">Sudah punya akun? <a href="/login">Login</a></p>
      </div>
    </div>
  </div>
</body>
</html>